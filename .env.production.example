# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=chatsfunnels
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=chatsfunnels
DATABASE_URL=postgresql://chatsfunnels:CHANGE_ME_strong_password@db:5432/chatsfunnels?schema=public

# ─── NextAuth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
# Replace with your server IP
NEXTAUTH_URL=http://YOUR_SERVER_IP:3000

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://YOUR_SERVER_IP:3000
NODE_ENV=production

// ChatsFunnels v2 - Prisma Schema
// SaaS platform for link funnels, click tracking, and group management

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum RoundStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum CreditType {
  PURCHASE
  USAGE
  BONUS
  REFUND
}

enum PixelType {
  FACEBOOK
  GOOGLE_ANALYTICS
  CUSTOM
}

// ─── NextAuth Models ─────────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Core Models ─────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  role          Role      @default(USER)
  image         String?
  credits       Int       @default(100)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  funnels        Funnel[]
  clicks         Click[]
  groups         Group[]
  domains        Domain[]
  trackingPixels TrackingPixel[]
  webhooks       Webhook[]
  accounts       Account[]
  sessions       Session[]
  creditHistory  Credit[]
  groupMembers   GroupMember[]
  landingPages   LandingPage[]
}

model Funnel {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  userId         String
  isActive       Boolean  @default(true)
  clicksPerRound Int      @default(10)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  links          Link[]
  clicks         Click[]
  rounds         Round[]
  domains        Domain[]
  trackingPixels TrackingPixel[]
  landingPages   LandingPage[]

  @@index([slug])
  @@index([userId])
}

model Link {
  id        String   @id @default(cuid())
  url       String
  funnelId  String
  order     Int
  clicks    Int      @default(0)
  weight    Float    @default(1.0)
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  funnel      Funnel  @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  clickEvents Click[]
}

model Click {
  id        String   @id @default(cuid())
  funnelId  String
  linkId    String
  ip        String?
  country   String?
  city      String?
  userAgent String?
  device    String?
  browser   String?
  os        String?
  referer   String?
  userId    String?
  createdAt DateTime @default(now())

  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  link   Link   @relation(fields: [linkId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([funnelId])
  @@index([linkId])
  @@index([ip])
  @@index([createdAt])
}

model Group {
  id         String   @id @default(cuid())
  name       String
  ownerId    String
  maxMembers Int      @default(50)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  owner   User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members GroupMember[]
  rounds  Round[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  linkUrl  String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Round {
  id                String      @id @default(cuid())
  funnelId          String?
  groupId           String?
  roundNumber       Int
  status            RoundStatus @default(ACTIVE)
  clicksDistributed Int         @default(0)
  maxClicks         Int
  startedAt         DateTime    @default(now())
  completedAt       DateTime?

  funnel Funnel? @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  group  Group?  @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Credit {
  id          String     @id @default(cuid())
  userId      String
  amount      Int
  type        CreditType
  description String?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Domain {
  id         String   @id @default(cuid())
  domain     String   @unique
  userId     String
  isVerified Boolean  @default(false)
  funnelId   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnel Funnel? @relation(fields: [funnelId], references: [id])

  @@index([domain])
}

model TrackingPixel {
  id        String    @id @default(cuid())
  userId    String
  name      String
  type      PixelType
  pixelId   String
  script    String?   @db.Text
  funnelId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnel Funnel? @relation(fields: [funnelId], references: [id])
}

model Webhook {
  id        String   @id @default(cuid())
  userId    String
  url       String
  events    String[]
  isActive  Boolean  @default(true)
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Page Builder ────────────────────────────────────────────────────────────

model LandingPage {
  id        String   @id @default(cuid())
  name      String
  userId    String
  funnelId  String?
  content   Json     @default("[]")
  published Boolean  @default(false)
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  funnel Funnel? @relation(fields: [funnelId], references: [id])

  @@index([userId])
  @@index([slug])
}
